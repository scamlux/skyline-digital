# OpenAI — server-side only. Never expose to the client.
OPENAI_API_KEY=
# Optional: override the model (must support structured outputs).
OPENAI_MODEL=gpt-4o-mini

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — server-side only. Never expose to the client / commit real values.
TELEGRAM_BOT_TOKEN=
# Chat of incoming leads (also receives manual-publish reminders).
TELEGRAM_CHAT_ID=
# Public content channel — a channel, NOT the leads chat. Posts publish here.
# Format: @channelusername or -100XXXXXXXXXX.
TELEGRAM_CHANNEL_ID=
# Bot that publishes to the channel (must be a channel admin with post rights).
# Separate from the leads bot above; falls back to TELEGRAM_BOT_TOKEN if unset.
TELEGRAM_CHANNEL_BOT_TOKEN=

# Content studio cron (/api/cron/content). Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Runs in UTC every 15 min.
CRON_SECRET=

# Public base URL of the app — used in manual-publish reminders (link to the post).
# e.g. https://skyline-digital.uz  (falls back to VERCEL_URL if unset).
NEXT_PUBLIC_SITE_URL=

# Instagram Content Publishing API (server-side only). Business account linked to
# a Facebook Page; app needs instagram_business_content_publish + _basic.
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
# Graph API version, e.g. v21.0 (optional; defaults in code).
INSTAGRAM_GRAPH_VERSION=

# Public base URL (used for absolute links in PDFs / OG). Optional in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Radar (Phase B) — company discovery
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
RADAR_REGION=uz
# Admin panel (/admin/radar) HTTP Basic Auth
ADMIN_USER=
ADMIN_PASSWORD=

# Демо-бот «Сводка в Telegram» (кабинеты шаблонов /sites/<ниша>/admin).
# Это ОТДЕЛЬНЫЙ бот из @BotFather — не бот заявок (TELEGRAM_BOT_TOKEN выше), его не трогаем.
# Токен демо-бота. Только на сервере, в клиентский код не попадает.
TELEGRAM_DIGEST_BOT_TOKEN=
# Секрет вебхука: любая случайная строка A-Z a-z 0-9 _ - (например `openssl rand -hex 32`).
# Тот же секрет скрипт scripts/telegram/set-digest-webhook.mjs передаёт Telegram как secret_token.
TELEGRAM_DIGEST_WEBHOOK_SECRET=
# Имя демо-бота без «@» (например skyline_demo_bot) — публичное, по нему строится ссылка кнопки
# «Получить в Telegram». Пусто — в кабинетах остаётся только превью сводки, без кнопки.
NEXT_PUBLIC_TELEGRAM_DIGEST_BOT=
